# ==============================================================================
# NANOAPI GATEWAY — PRODUCTION ENVIRONMENT SPECIFICATION (.env.example)
# Network: Arc Mainnet (Chain ID: 5042, CAIP-2: eip155:5042)
# Settlement: Circle Gateway Mainnet (Domain 26, Wallet: 0x77777777Dcc4d5A8B6E418Fd04D8997ef11000eE)
# Protocol: x402 V2 Exact EIP-712/EIP-3009 Nanopayments
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT CONFIGURATION (Safe for browser injection)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ARC_CHAIN_ID=5042
NEXT_PUBLIC_ARC_RPC=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER=https://explorer.arc.io
NEXT_PUBLIC_ARC_USDC_CONTRACT=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_GATEWAY_WALLET=0x77777777Dcc4d5A8B6E418Fd04D8997ef11000eE
NEXT_PUBLIC_GATEWAY_DOMAIN=26

# ------------------------------------------------------------------------------
# 2. SERVER SECRETS & PAYMENT RECIPIENT
# ------------------------------------------------------------------------------
# The seller's Arc Mainnet wallet address that collects nanopayment revenue
PAYMENT_RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000

# Server-Side Safety Spending Controls (in USDC)
MAX_SINGLE_PAYMENT_USDC=1.0
MAX_DAILY_SPEND_USDC=10.0

# ------------------------------------------------------------------------------
# 3. CIRCLE GATEWAY & FACILITATOR CONFIGURATION
# ------------------------------------------------------------------------------
# Circle Gateway Production REST URL (Default: https://gateway-api.circle.com)
CIRCLE_GATEWAY_API_URL=https://gateway-api.circle.com

# Circle Gateway API Credentials (optional for public Gateway REST endpoints, required for private management)
CIRCLE_API_KEY=

# ------------------------------------------------------------------------------
# 4. DATABASE & PERSISTENCE CONFIGURATION
# ------------------------------------------------------------------------------
# Path to atomic file-backed JSON database or connection string for Postgres/KV
DATABASE_STORAGE_PATH=./data/gateway_db.json

# ------------------------------------------------------------------------------
# 5. EXTERNAL API PROVIDER CREDENTIALS
# Note: In production, missing credentials trigger honest upstream errors (no fake data)
# ------------------------------------------------------------------------------
OPENWEATHER_API_KEY=
NEWS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
